#!/bin/sh
# Formats the staged Kotlin files before committing

# Always run from repo root
ROOT="$(git rev-parse --show-toplevel)";
cd "$ROOT"

# Only the files in the commit are re-staged, so unrelated changes in the working tree are never added.
# A file that is only partly staged is staged in full after formatting.
STAGED="$(git diff --cached --name-only --diff-filter=ACMR -- '*.kt' '*.kts')"
if [ -z "$STAGED" ]; then
  exit 0
fi


# --- Find Java even when GUI apps don't load your shell profile ---
# Try SDKMAN first, then macOS java_home, then PATH
if [ -d "$HOME/.sdkman/candidates/java/current" ]; then
  export JAVA_HOME="$HOME/.sdkman/candidates/java/current"
  export PATH="$JAVA_HOME/bin:$PATH"
elif command -v /usr/libexec/java_home >/dev/null 2>&1; then
  export JAVA_HOME="$(/usr/libexec/java_home -v 25 2>/dev/null || /usr/libexec/java_home 2>/dev/null || true)"
  [ -n "${JAVA_HOME:-}" ] && export PATH="$JAVA_HOME/bin:$PATH"
fi

if ! command -v java >/dev/null 2>&1; then
  echo "Java not found. If you use SDKMAN, ensure $HOME/.sdkman/candidates/java/current exists."
  exit 1
fi


# --- Use Maven Wrapper ---
if [ ! -x "./mvnw" ]; then
  echo "./mvnw not found or not executable. Run the Maven Wrapper plugin and 'chmod +x mvnw'."
  exit 1
fi


# Spotless is configured in nhn-adapter-app only
./mvnw -q -pl nhn-adapter-app spotless:apply || {
  echo "Commit blocked: formatting failed (see output above)."
  exit 1
}

echo "$STAGED" | xargs git add --

echo "Formatting OK."
